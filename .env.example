# ========================================================
# WORKLINK ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ========================================================

# 1. Server & Networking
PORT=5000
# Khi phát triển cục bộ: development | Khi deploy lên server thật: production
NODE_ENV=development
# URL Backend mà Frontend gọi tới (Không có dấu gạch chéo cuối '/')
# Ví dụ local: http://localhost:5000 | Ví dụ production: https://api.yourdomain.com
VITE_API_URL=http://localhost:5000

# 2. Cơ sở dữ liệu PostgreSQL (BẮT BUỘC)
# Định dạng: postgresql://[user]:[password]@[host]:[port]/[database]
# Ví dụ local (Docker Compose hoặc cài đặt trực tiếp):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/worklink
# Tùy chọn kết nối SSL khi dùng Cloud PostgreSQL (Neon, Supabase, Render, Railway, v.v.):
DATABASE_SSL=false
# Xác thực chứng chỉ SSL phía server (đặt true khi dùng Cloud DB với CA đáng tin cậy, false khi local)
DATABASE_SSL_REJECT_UNAUTHORIZED=false

# (Tùy chọn) Cấu hình tham số riêng lẻ thay vì DATABASE_URL:
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=postgres
# PGDATABASE=worklink

# 3. CORS Allowlist (CỰC KỲ QUAN TRỌNG KHI DEPLOY)
# Danh sách domain Frontend được phép gọi API (phân cách bằng dấu phẩy)
# Nếu thiếu biến này trên Production, CORS sẽ chặn mọi request từ Frontend thật!
ALLOWED_ORIGINS=https://your-frontend.vercel.app,https://your-domain.com

# 4. Bảo mật Xác thực JWT & Mã hóa Mật khẩu
# Sinh mã ngẫu nhiên 256-bit an toàn bằng lệnh: npm run secret:generate
JWT_SECRET=your_secure_256_bit_jwt_secret_key_here
# Số vòng băm Bcrypt (Khuyến nghị 12 cho Production)
BCRYPT_ROUNDS=12

# 5. Mật khẩu Khởi tạo Ban đầu (Tránh mật khẩu mặc định 123456 trên Production)
SEED_DEFAULT_PASSWORD=ChangeMeSecure123!
ADMIN_INITIAL_PASSWORD=AdminSecurePassword2026!

# 6. Dịch vụ Email SMTP cho tính năng "Quên mật khẩu"
# (Nếu không cấu hình, hệ thống sẽ tự động chuyển sang chế độ Demo: ghi log token ra console máy chủ)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password_here
EMAIL_FROM="WorkLink Security" <your_email@gmail.com>

# 7. Google Gemini AI Configuration
# Danh sách model hợp lệ: gemini-2.0-flash (mặc định), gemini-1.5-flash, gemini-1.5-pro
GEMINI_MODEL=gemini-2.0-flash
VITE_GEMINI_MODEL=gemini-2.0-flash
# Tùy chọn: Gemini API Key phía Server (người dùng không cần nhập key trên trình duyệt)
GEMINI_API_KEY=optional_google_gemini_api_key_here

# 8. Observability & Giám sát Lỗi (Production Monitoring)
# Tùy chọn Sentry DSN để bắt lỗi hệ thống thời gian thực:
SENTRY_DSN=

# 9. Lưu trữ Tệp tải lên (File Storage)
# Thư mục lưu file CV vật lý (Mặc định: uploads/cv)
CV_UPLOAD_DIR=

# 10. Các cờ bảo mật & triển khai khác
# Từ chối tất cả request không có Origin header trên Production (mặc định false):
STRICT_CORS=false
# Bật seed dữ liệu mẫu trên môi trường Production (mặc định false để bảo mật):
ALLOW_PRODUCTION_SEED=false
