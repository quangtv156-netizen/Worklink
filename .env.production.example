# ========================================================
# WORKLINK PRODUCTION ENVIRONMENT TEMPLATE (.env.production.example)
# Sử dụng file này khi triển khai ứng dụng lên máy chủ thật hoặc Docker
# ========================================================

# 1. Cấu hình Cổng & Môi trường
PORT=5000
NODE_ENV=production
# URL Backend thật (nếu triển khai chung server all-in-one: http://localhost:5000 hoặc domain thật)
VITE_API_URL=http://localhost:5000

# 2. Cơ sở dữ liệu PostgreSQL
# Mật khẩu mạnh bắt buộc (trên 16 ký tự, không dùng 'postgres')
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_strong_postgres_password_here
POSTGRES_DB=worklink

# Chuỗi kết nối PostgreSQL:
# - Với Docker Compose: postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
# - Với Máy chủ riêng / Cloud DB (Neon, Render, Railway, Supabase):
DATABASE_URL=postgresql://postgres:your_strong_postgres_password_here@postgres:5432/worklink
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# 3. Bảo mật Xác thực JWT (BẮT BUỘC >= 32 KÝ TỰ, KHÔNG DÙNG KHÓA DEFAULT)
# Sinh tự động: npm run secret:generate
JWT_SECRET=your_super_secure_jwt_secret_64_characters_hex_key_here
BCRYPT_ROUNDS=12

# 4. Mật khẩu Khởi tạo Ban đầu
ADMIN_INITIAL_PASSWORD=AdminSecurePass2026!
SEED_DEFAULT_PASSWORD=SeedUserSecurePass2026!

# 5. Phân quyền Tên miền (CORS) & Content Security Policy (CSP)
# Liệt kê các domain Frontend được phép truy cập API
ALLOWED_ORIGINS=http://localhost:5000,http://localhost:5173,https://your-domain.com
ENABLE_CSP=true

# 6. Dịch vụ Email SMTP (Tùy chọn cho Quên mật khẩu)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="WorkLink Security" <noreply@worklink.vn>

# 7. Google Gemini AI & OAuth
GEMINI_MODEL=gemini-2.0-flash
GEMINI_API_KEY=
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
ALLOW_MOCK_GOOGLE_AUTH=false

# 8. Production Security Flags
ALLOW_PRODUCTION_SEED=false
STRICT_CORS=true
COOKIE_ONLY_AUTH=true
REQUIRE_EMAIL_VERIFICATION=false
SENTRY_DSN=
